# Wheels downloaded for offline Linux install — regenerated by scripts/download_wheels.py
wheels/

# Per-task isolated workdirs created by core/workdir.py
runs/

# Per-task and per-run logs
logs/

# PDK health-check caches written next to config/profiles/<id>.yaml
*.health.json

# Python virtualenvs
.venv/
venv/
env/

# Byte-compiled artefacts
__pycache__/
*.pyc
*.pyo
*.pyd

# Editable install metadata
*.egg-info/
.eggs/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor/IDE
.vscode/
.idea/
*.swp
.DS_Store

# Site wordlist for scripts/redzone_scan.sh -- the wordlist IS the secret list
.redzone_patterns.local

# Claude Code session state (agent worktrees, local settings)
.claude/

# Red-zone deployment runtime state (backups / staging / scratch / seed).
# Created inside the install dir on the server -- and on this box too, whenever
# deploy/doctor.sh is run once. Never a commit.
.deploy/

# Packages built by deploy/pack.ps1
deploy/dist/
